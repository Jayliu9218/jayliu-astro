---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const projectTypes = Array.from(
  projects
    .reduce((map, project) => {
      const current = map.get(project.type);
      map.set(project.type, {
        label: project.type,
        labelZh: project.typeZh,
        count: (current?.count || 0) + 1,
      });
      return map;
    }, new Map<string, { label: string; labelZh: string; count: number }>())
    .values(),
);
---

<BaseLayout
  pageTitle="Projects"
  description="Jay Liu 的工程项目、网页实验、研究学习和长期维护项目。"
  pageClass="portfolio-page projects-portfolio-page"
>
  <main class="collection-shell projects-shell">
    <section class="collection-main project-index-section" id="project-index">
      <header class="collection-heading">
        <h1 data-i18n-en="Projects" data-i18n-zh="项目">Projects</h1>
        <p
          data-i18n-en="Research, engineering, and long-running technical work."
          data-i18n-zh="研究、工程实践与长期技术项目。"
        >
          Research, engineering, and long-running technical work.
        </p>
      </header>

      <div class="project-card-grid">
        {
          projects.map((project) => (
            <a class="project-card" href={project.href}>
              <div class="project-card-cover" aria-hidden="true">
                <span>{project.year}</span>
              </div>
              <div class="project-card-body">
                <div class="project-row-heading">
                  <h2
                    data-i18n-en={project.title}
                    data-i18n-zh={project.titleZh}
                  >
                    {project.title}
                  </h2>
                  <span
                    class="project-status"
                    data-i18n-en={project.status}
                    data-i18n-zh={project.statusZh}
                  >
                    {project.status}
                  </span>
                </div>
                <p
                  data-i18n-en={project.summary}
                  data-i18n-zh={project.summaryZh}
                >
                  {project.summary}
                </p>
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <nav
      class="collection-years project-filters"
      aria-label="Project types"
      data-i18n-aria-en="Project types"
      data-i18n-aria-zh="项目类型"
    >
      <a class="is-current" href="#project-index">
        <span data-i18n-en="All" data-i18n-zh="全部">All</span>
        <strong>{projects.length}</strong>
      </a>
      {
        projectTypes.map((type) => (
          <a href="#project-index">
            <span data-i18n-en={type.label} data-i18n-zh={type.labelZh}>
              {type.label}
            </span>
            <strong>{type.count}</strong>
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>
