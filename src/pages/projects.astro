---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const projectTypes = Array.from(
  projects
    .reduce((map, project) => {
      const current = map.get(project.type);
      map.set(project.type, {
        label: project.type,
        count: (current?.count || 0) + 1,
      });
      return map;
    }, new Map<string, { label: string; count: number }>())
    .values(),
);
---

<BaseLayout
  pageTitle="Projects"
  description="Jay Liu's engineering projects, web experiments, research learning, and long-running technical work."
  pageClass="portfolio-page projects-portfolio-page"
>
  <main class="collection-shell projects-shell">
    <section class="collection-main project-index-section" id="project-index">
      <header class="collection-heading">
        <h1>Projects</h1>
        <p>Research, engineering, and long-running technical work.</p>
      </header>

      <div class="project-card-grid">
        {
          projects.map((project) => (
            <a class="project-card" href={project.href}>
              <div class="project-card-cover" aria-hidden="true">
                <span>{project.year}</span>
              </div>
              <div class="project-card-body">
                <div class="project-row-heading">
                  <h2>{project.title}</h2>
                  <span class="project-status">{project.status}</span>
                </div>
                <p>{project.summary}</p>
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <nav class="collection-years project-filters" aria-label="Project types">
      <a class="is-current" href="#project-index">
        <span>All</span>
        <strong>{projects.length}</strong>
      </a>
      {
        projectTypes.map((type) => (
          <a href="#project-index">
            <span>{type.label}</span>
            <strong>{type.count}</strong>
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>
