---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profiles } from '../config/site';

const interests = [
  { en: 'Materials microstructure and microscopy', zh: '材料微结构与显微表征' },
  {
    en: 'FIB / SEM / TEM experimental workflows',
    zh: 'FIB / SEM / TEM 相关实验流程',
  },
  {
    en: 'Research data and reproducible analysis',
    zh: '科研数据整理与可复现分析',
  },
  {
    en: 'Knowledge systems, technical writing, and long-term learning',
    zh: '个人知识库、技术写作与长期学习',
  },
];
---

<BaseLayout
  pageTitle="Jay Liu"
  description="关于 Jay Liu 的研究兴趣、技术记录方式和联系方式。"
  pageClass="portfolio-page about-portfolio-page"
>
  <main class="portfolio-home about-home">
    <section
      class="portfolio-section about-focus-section about-list-section"
      data-home-section="about"
    >
      <div class="section-header">
        <div>
          <p class="section-label">About</p>
          <h1
            data-i18n-en="About and current focus"
            data-i18n-zh="关于与当前关注"
          >
            About and current focus
          </h1>
        </div>
      </div>

      <div class="about-layout">
        <div class="about-main">
          <p
            data-i18n-en="I connect materials, microscopy, code, and writing: collecting questions in experiments, building methods through analysis, and preserving judgment through writing."
            data-i18n-zh="我希望把材料、显微、代码和写作连接起来：在实验中积累问题，在分析中建立方法，在写作中沉淀判断。这个站点会优先收纳科研技术相关内容，也会保留一些个人项目和学习复盘。"
          >
            I connect materials, microscopy, code, and writing: collecting
            questions in experiments, building methods through analysis, and
            preserving judgment through writing.
          </p>

          <div class="focus-list" data-home-section="focus">
            <p
              class="section-label"
              data-i18n-en="Current focus"
              data-i18n-zh="当前关注"
            >
              Current focus
            </p>
            <ul class="clean-list">
              {
                interests.map((item) => (
                  <li data-i18n-en={item.en} data-i18n-zh={item.zh}>
                    {item.en}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <aside
          class="profile-card contact-card"
          id="contact-links"
          data-home-section="contact"
        >
          <p
            class="section-label"
            data-i18n-en="Contact and profiles"
            data-i18n-zh="联系与个人资料"
          >
            Contact and profiles
          </p>
          <ul class="contact-list">
            {
              profiles.map((profile) => (
                <li>
                  <a
                    href={profile.url}
                    target={
                      profile.url.startsWith('http') ? '_blank' : undefined
                    }
                    rel={
                      profile.url.startsWith('http') ? 'noreferrer' : undefined
                    }
                  >
                    <span>{profile.name}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
