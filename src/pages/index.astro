---
import { getCollection } from 'astro:content';
import PublicationItem from '../components/PublicationItem.astro';
import { academicProfile, profiles } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublications } from '../lib/publications';

const publications = await getPublications();
const selectedPublications = publications.filter((item) => item.selected);
const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const newsYear = (date: Date) => date.getFullYear();
const newsDay = (date: Date) =>
  new Intl.DateTimeFormat('en', { month: 'short', day: '2-digit' }).format(
    date,
  );
---

<BaseLayout
  pageTitle="Jay Liu"
  description="Jay Liu's academic homepage: stress corrosion cracking, microscopy, materials characterization, publications, and technical notes."
  pageClass="portfolio-page academic-home-page"
>
  <main class="academic-shell">
    <aside class="academic-profile" data-home-section="profile">
      <div class="portrait-placeholder" aria-label="Portrait placeholder">
        <span>{academicProfile.initials}</span>
        <small>Portrait</small>
      </div>

      <div class="profile-identity">
        <h1>{academicProfile.name}</h1>
        <p class="profile-position">{academicProfile.position}</p>
        <p class="profile-affiliation">{academicProfile.affiliation}</p>
      </div>

      <nav
        class="profile-links"
        id="contact-links"
        aria-label="Academic profiles"
      >
        {
          profiles.map((profile) => (
            <a
              class={
                profile.url.startsWith('mailto:') ? 'profile-email' : undefined
              }
              href={profile.url}
              target={profile.url.startsWith('http') ? '_blank' : undefined}
              rel={profile.url.startsWith('http') ? 'noreferrer' : undefined}
            >
              <span>{profile.name}</span>
            </a>
          ))
        }
      </nav>
    </aside>

    <div class="academic-main">
      <section class="academic-card academic-intro" data-home-section="about">
        <h2>About Me</h2>
        <p class="academic-statement">{academicProfile.bio}</p>
        <div class="research-interests" data-home-section="focus">
          <h3>Research Interests</h3>
          <ul>
            {academicProfile.interests.map((interest) => <li>{interest}</li>)}
          </ul>
        </div>
      </section>

      <section
        class="academic-card background-section"
        data-home-section="education"
      >
        <div class="background-column">
          <h2>Education</h2>
          <ol class="education-list">
            {
              academicProfile.education.map((item) => (
                <li>
                  <span class="institution-badge" aria-hidden="true">
                    SJ
                  </span>
                  <div>
                    <h3>{item.institution}</h3>
                    <p>{item.degree}</p>
                    <time>{item.period}</time>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="background-column honors-column">
          <h2>Honors & Awards</h2>
          <ul class="honors-list">
            {
              academicProfile.honors.map((item) => (
                <li>
                  <span>{item.name}</span>
                  <time>{item.year}</time>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section
        class="academic-card academic-section news-section"
        data-home-section="news"
      >
        <div class="academic-section-heading">
          <h2>News</h2>
        </div>
        <div class="news-list">
          {
            news.map((item) => {
              const content = (
                <>
                  <time datetime={item.data.date.toISOString()}>
                    <span>{newsYear(item.data.date)}</span>
                    <i>{newsDay(item.data.date)}</i>
                  </time>
                  <span>{item.data.title}</span>
                </>
              );

              return item.data.url ? (
                <a class="news-row" href={item.data.url}>
                  {content}
                </a>
              ) : (
                <div class="news-row">{content}</div>
              );
            })
          }
        </div>
      </section>

      <section
        class="academic-card academic-section selected-publications"
        data-home-section="publications"
      >
        <div class="academic-section-heading">
          <h2>Selected Publications</h2>
          <a class="see-all" href="/publications/"> view all &gt;&gt; </a>
        </div>
        <div class="publication-list compact-publications">
          {
            selectedPublications.map((publication, index) => (
              <PublicationItem publication={publication} index={index} />
            ))
          }
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
