---
import PublicationItem from '../components/PublicationItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublications } from '../lib/publications';

const publications = await getPublications();
const years = [...new Set(publications.map((item) => item.year))];
---

<BaseLayout
  pageTitle="Publications"
  description="Peer-reviewed publications by Jie Liu on stress corrosion cracking, stainless steels, and materials characterization."
  pageClass="portfolio-page publications-page"
>
  <main class="collection-shell publications-shell">
    <div class="collection-main publication-groups">
      {
        years.map((year) => {
          const items = publications.filter((item) => item.year === year);
          return (
            <section class="publication-year-group" id={`year-${year}`}>
              <h1 class="year-heading">{year}</h1>
              <div class="publication-list collection-card">
                {items.map((publication, index) => (
                  <PublicationItem publication={publication} index={index} />
                ))}
              </div>
            </section>
          );
        })
      }
    </div>

    <nav
      class="collection-years publication-years"
      aria-label="Publication years"
    >
      {
        years.map((year, index) => (
          <a
            class={index === 0 ? 'is-current' : undefined}
            href={`#year-${year}`}
          >
            {year}
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>
