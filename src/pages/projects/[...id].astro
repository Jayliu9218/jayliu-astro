---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const data = project.data;
---

<BaseLayout
  pageTitle={data.title}
  description={data.summary}
  pageClass="portfolio-page project-detail-page"
>
  <main class="page-shell project-detail-shell">
    <nav class="detail-nav-bar" aria-label="Project navigation">
      <a href="/projects/">Back to Projects</a>
      <a href="/blog/">Documents</a>
      <a href="/">About</a>
    </nav>

    <article class="project-detail">
      <header class="project-detail-header">
        <p class="section-label">{data.type}</p>
        <div class="project-detail-meta">
          <span>{data.year}</span>
          <span>{data.status}</span>
        </div>
        <h1>{data.title}</h1>
        <p>{data.summary}</p>
        <div class="project-tags">
          {data.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <div class="hero-actions project-actions">
          {
            data.demoUrl && (
              <a
                class="btn btn-primary"
                href={data.demoUrl}
                target="_blank"
                rel="noreferrer"
              >
                Open live project
              </a>
            )
          }
          {
            data.repositoryUrl && (
              <a
                class="btn btn-secondary"
                href={data.repositoryUrl}
                target="_blank"
                rel="noreferrer"
              >
                View repository
              </a>
            )
          }
          {
            data.relatedDocument && (
              <a class="btn btn-secondary" href={data.relatedDocument}>
                Read related document
              </a>
            )
          }
        </div>
      </header>

      <div class="project-detail-layout">
        <section class="project-overview">
          <p class="section-label">Overview</p>
          <h2>What this project is for</h2>
          <p>{data.overview}</p>
        </section>

        <aside class="project-facts">
          <p class="section-label">Details</p>
          <dl>
            <div>
              <dt>Type</dt>
              <dd>{data.type}</dd>
            </div>
            <div>
              <dt>Year</dt>
              <dd>{data.year}</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>{data.status}</dd>
            </div>
          </dl>
        </aside>
      </div>

      <section class="project-highlights">
        <div class="section-header compact">
          <div>
            <p class="section-label">Highlights</p>
            <h2>Key decisions</h2>
          </div>
        </div>
        <ol>
          {
            data.highlights.map((highlight, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{highlight}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </article>
  </main>
</BaseLayout>
