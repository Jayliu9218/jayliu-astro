---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((post) => post.year))];
---

<BaseLayout
  pageTitle="Documents"
  description="Jay Liu 的科研技术笔记、实验记录、项目复盘和学习日志。"
  pageClass="portfolio-page blog-portfolio-page"
>
  <main class="collection-shell blog-shell">
    <div class="collection-main document-groups">
      {
        years.map((year) => (
          <section class="document-year-group" id={`year-${year}`}>
            <h1 class="year-heading">{year}</h1>
            <div
              class="document-list collection-card"
              aria-label={`${year} post list`}
            >
              {posts
                .filter((post) => post.year === year)
                .map((post) => (
                  <article class="document-row">
                    <h2>
                      <a href={post.href}>{post.title}</a>
                    </h2>
                    <div class="document-row-meta">
                      <time
                        datetime={
                          post.dateValue ? post.date.toISOString() : undefined
                        }
                        data-i18n-en={post.dateLabelEn}
                        data-i18n-zh={post.dateLabel}
                      >
                        {post.dateLabelEn}
                      </time>
                      <span
                        data-i18n-en={post.category.labelEn}
                        data-i18n-zh={post.category.label}
                      >
                        {post.category.labelEn}
                      </span>
                      {post.tags.slice(0, 3).map((tag) => (
                        <span>{tag}</span>
                      ))}
                    </div>
                    <p>{post.description}</p>
                    <a
                      class="read-more"
                      href={post.href}
                      data-i18n-en="Read more >>"
                      data-i18n-zh="阅读全文 >>"
                    >
                      Read more &gt;&gt;
                    </a>
                  </article>
                ))}
            </div>
          </section>
        ))
      }
    </div>

    <nav
      class="collection-years"
      aria-label="Document years"
      data-i18n-aria-en="Document years"
      data-i18n-aria-zh="文档年份"
    >
      {
        years.map((year, index) => (
          <a
            class={index === 0 ? 'is-current' : undefined}
            href={`#year-${year}`}
          >
            {year}
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>
