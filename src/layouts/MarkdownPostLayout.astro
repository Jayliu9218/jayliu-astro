---
import BaseLayout from './BaseLayout.astro';

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

const { frontmatter, headings = [] } = Astro.props;
const tocHeadings = (headings as Heading[]).filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const date = new Date(frontmatter.pubDate);
const dateLabel = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const dateLabelEn = date.toLocaleDateString('en', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  pageClass="portfolio-page article-portfolio-page"
  pageImage={frontmatter.image?.url}
  pageType="article"
>
  <main class="page-shell article-shell">
    <div class="article-layout">
      <article class="article-page">
        <header class="article-header">
          <p class="section-label" data-i18n-en="Writing" data-i18n-zh="写作">
            Writing
          </p>
          <div class="article-meta">
            <time
              datetime={date.toISOString()}
              data-i18n-en={dateLabelEn}
              data-i18n-zh={dateLabel}
            >
              {dateLabelEn}
            </time>
            {frontmatter.author && <span>{frontmatter.author}</span>}
          </div>
          <h1>{frontmatter.title}</h1>
          {frontmatter.description && <p>{frontmatter.description}</p>}
          {
            frontmatter.tags && (
              <div class="post-tags">
                {frontmatter.tags.map((tag: string) => (
                  <span>{tag}</span>
                ))}
              </div>
            )
          }
        </header>
        {
          frontmatter.image?.url && (
            <img
              class="article-image"
              src={frontmatter.image.url}
              alt={frontmatter.image.alt || ''}
            />
          )
        }
        <div class="article-content" id="article-content">
          <slot />
        </div>
      </article>

      {
        tocHeadings.length > 0 && (
          <aside
            class="article-sidebar"
            aria-label="Table of contents"
            data-i18n-aria-en="Table of contents"
            data-i18n-aria-zh="文章目录"
          >
            <div class="article-toc-card">
              <p
                class="panel-title"
                data-i18n-en="Contents"
                data-i18n-zh="目录"
              >
                Contents
              </p>
              <nav id="article-toc" class="article-toc">
                {tocHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class={heading.depth === 3 ? 'toc-child' : undefined}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          </aside>
        )
      }
    </div>
  </main>
</BaseLayout>
