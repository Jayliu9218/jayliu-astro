---
import { profiles } from '../config/site';
---

<footer class="site-footer" id="contact">
  <span class="footer-name">Jay Liu</span>
  <div class="footer-links" aria-label="联系链接">
    {
      profiles.map((profile) => (
        <a
          href={profile.url}
          target={profile.url.startsWith('http') ? '_blank' : undefined}
          rel={profile.url.startsWith('http') ? 'noreferrer' : undefined}
        >
          {profile.name}
        </a>
      ))
    }
  </div>
  <span class="footer-copy">© 2026</span>
</footer>
